# Local development settings only. Do not place real secrets in this file.
# Host port published by Docker Compose.
REVIO_PORT=8000

# Phase 2 GitHub read adapter. Keep disabled unless configuring a sandbox GitHub App.
REVIO_ENVIRONMENT=local
REVIO_GITHUB_ENABLED=false
REVIO_GITHUB_SANDBOX_WEBHOOK_ENABLED=false
REVIO_GITHUB_APP_ID=
# Configure exactly one private-key source when GitHub is enabled.
REVIO_GITHUB_PRIVATE_KEY_FILE=
# REVIO_GITHUB_PRIVATE_KEY=
REVIO_GITHUB_WEBHOOK_SECRET=
REVIO_GITHUB_API_URL=https://api.github.com
REVIO_GITHUB_API_VERSION=2022-11-28
REVIO_GITHUB_HTTP_TIMEOUT_SECONDS=10
REVIO_GITHUB_TOKEN_REFRESH_MARGIN_SECONDS=60
REVIO_GITHUB_TOKEN_MINIMUM_USABLE_LIFETIME_SECONDS=30
REVIO_GITHUB_WEBHOOK_MAX_BYTES=1048576
REVIO_GITHUB_MAX_PAGES=30
REVIO_GITHUB_MAX_ITEMS=3000
