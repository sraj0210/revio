# Local development settings only. Do not place real secrets in this file.
# Host port published by Docker Compose.
VENAROQ_PORT=8000

# Phase 3 durable SQLite queue.
VENAROQ_DATABASE_PATH=/var/lib/venaroq/venaroq.db
VENAROQ_DATABASE_WAL_ENABLED=true
VENAROQ_DATABASE_SYNCHRONOUS=FULL
VENAROQ_DATABASE_BUSY_TIMEOUT_MS=500
VENAROQ_DATABASE_BUSY_MAX_ATTEMPTS=3
VENAROQ_DATABASE_BUSY_MAX_ELAPSED_SECONDS=2
VENAROQ_DATABASE_REQUIRE_CURRENT_MIGRATION=true
VENAROQ_QUEUE_POLL_INTERVAL_SECONDS=1
VENAROQ_QUEUE_LEASE_SECONDS=60
VENAROQ_QUEUE_HEARTBEAT_SECONDS=20
VENAROQ_QUEUE_MAX_ATTEMPTS=5
VENAROQ_QUEUE_RETRY_BASE_SECONDS=5
VENAROQ_QUEUE_RETRY_MAX_SECONDS=300
VENAROQ_QUEUE_RETRY_JITTER_RATIO=0.2
VENAROQ_QUEUE_WORKER_CONCURRENCY=1
VENAROQ_QUEUE_SHUTDOWN_TIMEOUT_SECONDS=30
VENAROQ_QUEUE_MAX_ACTIVE_JOBS=10000
VENAROQ_QUEUE_MAX_EVENT_JSON_BYTES=16384
VENAROQ_RETENTION_TERMINAL_AGE_DAYS=30
VENAROQ_RETENTION_BATCH_SIZE=500
# Phase 6: confirmed-closed finding history becomes prunable this many days after resolution.
VENAROQ_RETENTION_CLOSED_FINDING_AGE_DAYS=180

# GitHub remains read-only. durable is the production ingress mode.
VENAROQ_ENVIRONMENT=local
VENAROQ_GITHUB_ENABLED=false
VENAROQ_GITHUB_ALLOW_IDLE_WORKER=false
VENAROQ_GITHUB_WEBHOOK_MODE=disabled
VENAROQ_GITHUB_APP_ID=
# Configure exactly one private-key source when GitHub is enabled.
VENAROQ_GITHUB_PRIVATE_KEY_FILE=
# VENAROQ_GITHUB_PRIVATE_KEY=
VENAROQ_GITHUB_WEBHOOK_SECRET=
VENAROQ_GITHUB_API_URL=https://api.github.com
VENAROQ_GITHUB_API_VERSION=2022-11-28
VENAROQ_GITHUB_HTTP_TIMEOUT_SECONDS=10
VENAROQ_GITHUB_TOKEN_REFRESH_MARGIN_SECONDS=60
VENAROQ_GITHUB_TOKEN_MINIMUM_USABLE_LIFETIME_SECONDS=30
VENAROQ_GITHUB_WEBHOOK_MAX_BYTES=1048576
VENAROQ_GITHUB_MAX_PAGES=30
VENAROQ_GITHUB_MAX_ITEMS=3000

# Phase 4 review execution is opt-in; publishing is sandbox/local only.
VENAROQ_REVIEW_ENABLED=false
VENAROQ_REVIEW_PUBLISH_ENABLED=false
VENAROQ_REVIEW_MODEL_ALIAS=
VENAROQ_REVIEW_FALLBACK_ALIAS=review-default
VENAROQ_REVIEW_INPUT_TOKEN_CEILING=120000
VENAROQ_REVIEW_INPUT_TOKEN_SAFETY_MARGIN=2000
VENAROQ_REVIEW_OUTPUT_TOKEN_CEILING=8192
VENAROQ_REVIEW_MAX_FILES=100
VENAROQ_REVIEW_MAX_LINES=12000
VENAROQ_REVIEW_MAX_BYTES=524288
VENAROQ_REVIEW_MAX_PATCH_BYTES=65536
VENAROQ_REVIEW_MAX_FINDINGS=50
VENAROQ_REVIEW_INLINE_CONFIDENCE=0.8
VENAROQ_REVIEW_SUMMARY_CONFIDENCE=0.6
# Stable identities use provider:installation-id:repository-id. Empty denies rollout.
VENAROQ_REVIEW_ROLLOUT_REPOSITORIES=
VENAROQ_REVIEW_ALLOW_REPOSITORY_OPTOUT=false
VENAROQ_REVIEW_DRAFTS_ENABLED=true
VENAROQ_REVIEW_PROTECTED_EXCLUSIONS=

# Agent mode: bounded, read-only tool-assisted verification (get_file/get_tree). Off by default; it
# also requires an agent-capable model alias (VENAROQ_REVIEW_MODEL_ALIAS=agent-review-default) and an
# SCM with file/tree access, or the review silently stays diff-only.
VENAROQ_REVIEW_AGENT_MODE_ENABLED=false
VENAROQ_REVIEW_AGENT_MAX_TURNS=10
VENAROQ_REVIEW_AGENT_MAX_TOOL_CALLS=8
VENAROQ_REVIEW_AGENT_MAX_FILES=10
VENAROQ_REVIEW_AGENT_MAX_BYTES_PER_FILE=65536
VENAROQ_REVIEW_AGENT_MAX_AGGREGATE_BYTES=262144

VENAROQ_ANTHROPIC_ENABLED=false
# Configure exactly one API-key source when Anthropic is enabled.
VENAROQ_ANTHROPIC_API_KEY_FILE=
# VENAROQ_ANTHROPIC_API_KEY=
VENAROQ_ANTHROPIC_API_URL=https://api.anthropic.com
VENAROQ_ANTHROPIC_API_VERSION=2023-06-01
VENAROQ_ANTHROPIC_HTTP_TIMEOUT_SECONDS=60

# OpenAI is an alternative review provider; select it with
# VENAROQ_REVIEW_MODEL_ALIAS=openai-review-default. Configure exactly one API-key source when enabled.
VENAROQ_OPENAI_ENABLED=false
VENAROQ_OPENAI_API_KEY_FILE=
# VENAROQ_OPENAI_API_KEY=
VENAROQ_OPENAI_API_URL=https://api.openai.com
VENAROQ_OPENAI_HTTP_TIMEOUT_SECONDS=60

# Required only when review publishing is enabled; configure exactly one source.
VENAROQ_PUBLISH_MARKER_KEY_FILE=
# VENAROQ_PUBLISH_MARKER_KEY=
# Production publishing is fail-closed: it also requires a non-empty rollout allow-list and
# file-based secret sources for the marker key, GitHub private key, and Anthropic API key.
VENAROQ_PRODUCTION_PUBLISH_CONFIRMED=false

# Phase 7 observability. Metrics are served only on a separate internal bind, never on the
# public webhook listener; leave VENAROQ_METRICS_BIND empty to disable the metrics server.
VENAROQ_LOG_LEVEL=info
VENAROQ_LOG_FORMAT=json
VENAROQ_METRICS_BIND=
VENAROQ_METRICS_PORT=9090
# Per-source webhook ingress rate limit (fixed window), fail-closed.
VENAROQ_INGRESS_RATE_LIMIT=120
VENAROQ_INGRESS_RATE_WINDOW_SECONDS=60
