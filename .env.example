# Local development settings only. Do not place real secrets in this file.
# Host port published by Docker Compose.
REVIO_PORT=8000

# Phase 3 durable SQLite queue.
REVIO_DATABASE_PATH=/var/lib/revio/revio.db
REVIO_DATABASE_WAL_ENABLED=true
REVIO_DATABASE_SYNCHRONOUS=FULL
REVIO_DATABASE_BUSY_TIMEOUT_MS=500
REVIO_DATABASE_BUSY_MAX_ATTEMPTS=3
REVIO_DATABASE_BUSY_MAX_ELAPSED_SECONDS=2
REVIO_DATABASE_REQUIRE_CURRENT_MIGRATION=true
REVIO_QUEUE_POLL_INTERVAL_SECONDS=1
REVIO_QUEUE_LEASE_SECONDS=60
REVIO_QUEUE_HEARTBEAT_SECONDS=20
REVIO_QUEUE_MAX_ATTEMPTS=5
REVIO_QUEUE_RETRY_BASE_SECONDS=5
REVIO_QUEUE_RETRY_MAX_SECONDS=300
REVIO_QUEUE_RETRY_JITTER_RATIO=0.2
REVIO_QUEUE_WORKER_CONCURRENCY=1
REVIO_QUEUE_SHUTDOWN_TIMEOUT_SECONDS=30
REVIO_QUEUE_MAX_ACTIVE_JOBS=10000
REVIO_QUEUE_MAX_EVENT_JSON_BYTES=16384
REVIO_RETENTION_TERMINAL_AGE_DAYS=30
REVIO_RETENTION_BATCH_SIZE=500

# GitHub remains read-only. durable is the production ingress mode.
REVIO_ENVIRONMENT=local
REVIO_GITHUB_ENABLED=false
REVIO_GITHUB_ALLOW_IDLE_WORKER=false
REVIO_GITHUB_WEBHOOK_MODE=disabled
REVIO_GITHUB_APP_ID=
# Configure exactly one private-key source when GitHub is enabled.
REVIO_GITHUB_PRIVATE_KEY_FILE=
# REVIO_GITHUB_PRIVATE_KEY=
REVIO_GITHUB_WEBHOOK_SECRET=
REVIO_GITHUB_API_URL=https://api.github.com
REVIO_GITHUB_API_VERSION=2022-11-28
REVIO_GITHUB_HTTP_TIMEOUT_SECONDS=10
REVIO_GITHUB_TOKEN_REFRESH_MARGIN_SECONDS=60
REVIO_GITHUB_TOKEN_MINIMUM_USABLE_LIFETIME_SECONDS=30
REVIO_GITHUB_WEBHOOK_MAX_BYTES=1048576
REVIO_GITHUB_MAX_PAGES=30
REVIO_GITHUB_MAX_ITEMS=3000

# Phase 4 review execution is opt-in; publishing is sandbox/local only.
REVIO_REVIEW_ENABLED=false
REVIO_REVIEW_PUBLISH_ENABLED=false
REVIO_REVIEW_MODEL_ALIAS=review-default
REVIO_REVIEW_FALLBACK_ALIAS=review-default
REVIO_REVIEW_INPUT_TOKEN_CEILING=120000
REVIO_REVIEW_INPUT_TOKEN_SAFETY_MARGIN=2000
REVIO_REVIEW_OUTPUT_TOKEN_CEILING=8192
REVIO_REVIEW_MAX_FILES=100
REVIO_REVIEW_MAX_LINES=12000
REVIO_REVIEW_MAX_BYTES=524288
REVIO_REVIEW_MAX_PATCH_BYTES=65536
REVIO_REVIEW_MAX_FINDINGS=50
REVIO_REVIEW_INLINE_CONFIDENCE=0.8
REVIO_REVIEW_SUMMARY_CONFIDENCE=0.6

REVIO_ANTHROPIC_ENABLED=false
# Configure exactly one API-key source when Anthropic is enabled.
REVIO_ANTHROPIC_API_KEY_FILE=
# REVIO_ANTHROPIC_API_KEY=
REVIO_ANTHROPIC_API_URL=https://api.anthropic.com
REVIO_ANTHROPIC_API_VERSION=2023-06-01
REVIO_ANTHROPIC_HTTP_TIMEOUT_SECONDS=60

# Required only when review publishing is enabled; configure exactly one source.
REVIO_PUBLISH_MARKER_KEY_FILE=
# REVIO_PUBLISH_MARKER_KEY=
